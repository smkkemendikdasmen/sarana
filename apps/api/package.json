{
  "name": "@saranasmk/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API backend untuk platform SARANA SMK",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --loader ts-node/esm --test src/**/*.test.ts",
    "migrate:up": "tsx --tsconfig tsconfig.json src/migrations/runner.ts up",
    "migrate:down": "tsx --tsconfig tsconfig.json src/migrations/runner.ts down",
    "migrate:pending": "tsx --tsconfig tsconfig.json src/migrations/runner.ts pending",
    "migrate:executed": "tsx --tsconfig tsconfig.json src/migrations/runner.ts executed",
    "migrate:create": "tsx --tsconfig tsconfig.json src/migrations/runner.ts create"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "google-auth-library": "^10.9.1",
    "googleapis": "^176.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "mysql2": "^3.24.2",
    "nestjs-cls": "^5.4.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "umzug": "^3.8.3"
  }
}
